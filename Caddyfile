{
	admin off
	auto_https off
	persist_config off
}

:80 {
	root * /srv

	# Hugo fingerprints these, so a change gets a new URL.
	@hashed path_regexp \.[0-9a-f]{20,}\.(css|m?js)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Stable names: long cache, but revalidate.
	@media path_regexp \.(svg|png|jpe?g|webp|avif|gif|ico|woff2?|ttf|otf)$
	header @media Cache-Control "public, max-age=2592000"

	header ?Cache-Control "no-cache"

	# Compressed at image build; the front proxy's encode skips encoded responses.
	file_server {
		precompressed br zstd gzip
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server {
			precompressed br zstd gzip
		}
	}
}
