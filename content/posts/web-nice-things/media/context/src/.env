# Context-shot unit. Holds the one output of make-quality-comparison.sh that is
# an ordinary photograph rather than a pixel comparison: the full frame scaled
# down with the crop region outlined.
#
# It lives in its own unit purely so it can be lossy. Lossless-vs-lossy is a
# per-unit setting, and the sibling ../src unit must stay lossless for the
# magnified crops, which would otherwise inherit artifacts the panel exists to
# show. Nothing here needs to be exact: it is a photograph whose only job is to
# say "the crop came from here", and lossless was costing an order of magnitude.
PNG_CONVERT_LOSSLESS=false

# The source arrives at the photo's native resolution, so it gets the same
# responsive ladder as every other photograph rather than one hardcoded width.
AVIF_SIZES="${SIZES_DEFAULT}"

# Rescale off so the native rung really is native: the source is well past
# PNG_RESCALE_THRESHOLD, and 'auto' would shrink it before the ladder ever ran,
# capping the top rung and quietly changing what "full size" means.
PNG_RESCALE=false
