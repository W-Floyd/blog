# make-quality-comparison.sh crops one patch, losslessly, from the pipeline's
# source photograph, and writes the context shot into the sibling ../context unit.
PROCESS_SCRIPT=true

# The crop is encoded by the ordinary AVIF pass, exactly like any other image
# here: once to AVIF_SSIMULACRA2 and once to AVIF_HQ_SSIMULACRA2. Those two files
# are what the page shows, side by side and unmodified — so the figure is a pair
# of genuine encoder outputs at the site's real targets, not a picture of them.
#
# Both targets are therefore left at their global defaults on purpose (65 and 85).
# Overriding either would make the figure illustrate something the site does not
# actually ship.
PNG_CONVERT_LOSSLESS=false

# No AVIF_SIZES: exactly two outputs, at the crop's native 240px. A responsive
# ladder would resample them, and any resample blurs the encoded pixel structure
# that is the entire subject of the figure. The page enlarges them in CSS instead,
# which is nearest-neighbour and adds nothing.
