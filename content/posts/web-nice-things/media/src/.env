# make-quality-comparison.sh generates the AVIF normal-vs-hq comparison PNGs.
PROCESS_SCRIPT=true

# Those are deliberately point-scaled pixel-comparison images: they must reach
# the page byte-for-byte. PNG_CONVERT_LOSSLESS (default true) gives lossless
# WebP so no artifacts are added, and rescale is off so the magnified crops
# aren't shrunk below the threshold and blurred.
PNG_RESCALE=false
