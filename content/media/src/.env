# The avatar's CSS widths (.avatar img: 20rem, 17rem on narrow screens).
AVIF_DISPLAY_REM='17,20'
# avatar.png is an intermediate (avatar_build.sh) of a photo: encode it lossy
# like a JPEG, not to the lossless WebP a PNG gets by default.
PNG_CONVERT_LOSSLESS=false
# SSIMULACRA2 averages over the whole frame, and the cutout's transparent ~60%
# scores as perfect, so the face lands ~4 points under target. 70 puts the face
# at ~67.
AVIF_SSIMULACRA2=70
PROCESS_SCRIPT=true
