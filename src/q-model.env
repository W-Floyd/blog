# Generated by q_regression.py from the encode log. Committed so a
# fresh clone starts with a converged search; rewritten by any build
# that produces new encodes. These are search *seeds* only — every
# candidate is still verified against the real SSIMULACRA2 target, so
# a stale model costs extra probes and never changes an output byte.
# Fitted for encoder speed/subsampling 0.
#
# Keys without a subsampling suffix are the fallback fit across all
# modes; a 420/444 key wins when the source resolves to that mode.
# normal/all: R^2 0.002, RMSE 7.2, n=1005
AVIF_SEED_A=47.830
AVIF_SEED_B=-0.490
# normal/420: R^2 0.003, RMSE 6.9, n=965
AVIF_SEED_420_A=48.893
AVIF_SEED_420_B=-0.571
# normal/444: R^2 0.402, RMSE 2.9, n=40
AVIF_SEED_444_A=55.015
AVIF_SEED_444_B=-3.175
# hq/all: R^2 0.103, RMSE 6.9, n=1001
AVIF_SEED_HQ_A=57.686
AVIF_SEED_HQ_B=3.286
# hq/420: R^2 0.116, RMSE 6.2, n=961
AVIF_SEED_HQ_420_A=58.891
AVIF_SEED_HQ_420_B=3.205
# hq/444: R^2 0.014, RMSE 3.5, n=40
AVIF_SEED_HQ_444_A=69.642
